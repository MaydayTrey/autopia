# Copy to .env and fill in. Nothing here is required to run the pipeline without the LLM pass.

# Anthropic API key. Only used by the AGGREGATE stage's LLM pass (worker only, never the server).
# Create one at https://console.anthropic.com. Leave unset to run rules-only.
ANTHROPIC_API_KEY=

# Model for the interpretation pass. Default: claude-opus-5-5. Use claude-haiku-5-5 for cheap iteration.
AUTOPIA_MODEL=claude-opus-5-5

# Database. Leave unset to use the embedded PGlite database in ./data/pglite (no install needed).
# Set to a Postgres URL (e.g. postgres://user:pass@localhost:5432/autopia) to use real Postgres.
DATABASE_URL=

# HTTP MCP server (npm run mcp:http). Set a token on any public deployment; unset = open endpoint.
AUTOPIA_MCP_TOKEN=
AUTOPIA_MCP_PORT=4200
