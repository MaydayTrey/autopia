{
  "name": "anthropic-api",
  "category": "llm-provider",
  "spec_url": "specs/anthropic.yml",
  "baseline": {
    "/v1/models/{model_id}": { "model_id": "claude-opus-5-5" }
  },
  "optional_values": {
    "/v1/models": { "limit": "5", "before_id": "claude-opus-5-5", "after_id": "claude-opus-5-5" }
  },
  "headers": {
    "x-api-key": "${ANTHROPIC_API_KEY}",
    "anthropic-version": "2023-06-01",
    "user-agent": "autopia/0.1 (read-only API behavior research; github.com/MaydayTrey/autopia)"
  },
  "rate": { "concurrency": 1, "min_interval_ms": 500 },
  "max_trials": 200
}
